#include <stdio.h>
#include <string.h>
#include <ctype.h>

struct contact
{
    char name[20];
    char phone[11];
    char email[25];
};

struct addressbook
{
    struct contact c[100];
    int contactcount;
};

/* Function declarations */
void create(struct addressbook *book);
void search(struct addressbook *book);
void edit(struct addressbook *book);
void delete(struct addressbook *book);
void save(struct addressbook *book);
void list(struct addressbook *book);
void loadContactsFromFile(struct addressbook *book);

int searchContact(struct addressbook *book);
int namevalidation(char *name);
int phonevalidation(char *phone);
int emailvalidation(char *email);

/* Name validation */
int namevalidation(char *name)
{
    int i = 0;

    while (name[i] != '\0')
    {
        if (!(isalpha(name[i]) || name[i] == '.' || name[i] == ' '))
        {
            return 0;
        }
        i++;
    }

    return 1;
}

/* Phone validation */
int phonevalidation(char *phone)
{
    int i;

    if (strlen(phone) != 10)
    {
        return 0;
    }

    for (i = 0; i < 10; i++)
    {
        if (!isdigit(phone[i]))
        {
            return 0;
        }
    }

    return 1;
}

/* Email validation */
int emailvalidation(char *email)
{
    char *at;
    char *dot;

    at = strchr(email, '@');
    dot = strstr(email, ".com");

    if (at == NULL || dot == NULL)
    {
        return 0;
    }

    if (at == email)
    {
        return 0;
    }

    if (at[1] == '.')
    {
        return 0;
    }

    if (strcmp(dot, ".com") != 0)
    {
        return 0;
    }

    return 1;
}

/* create contact */
void create(struct addressbook *book)
{
    int i = 0;
    int j = 0;
    int valid = 0;
    int numvalid = 0;
    int duplicate = 0;

    /* read name */
    printf("Enter the name: ");

    do
    {
        scanf(" %[^\n]", book->c[book->contactcount].name);

        valid = namevalidation(book->c[book->contactcount].name);

        if (valid == 0)
        {
            printf("enter valid character: ");
        }

    } while (valid != 1);

    /* read mobile number */
    printf("Enter the mobile number: ");

    do
    {
        scanf(" %10s", book->c[book->contactcount].phone);

        numvalid = phonevalidation(
            book->c[book->contactcount].phone);

        duplicate = 0;

        for (j = 0; j < book->contactcount; j++)
        {
            if (strcmp(book->c[j].phone,
                       book->c[book->contactcount].phone) == 0)
            {
                duplicate = 1;
                break;
            }
        }

        if (numvalid == 0)
        {
            printf("Enter the valid phone number: ");
        }
        else if (duplicate == 1)
        {
            printf("Phone number already exists. Enter different phone number: ");
        }

    } while (numvalid != 1 || duplicate == 1);

    /* read Email id */
    printf("Enter the Emailid: ");

    do
    {
        scanf(" %[^\n]", book->c[book->contactcount].email);

        valid = emailvalidation(
            book->c[book->contactcount].email);

        if (valid == 0)
        {
            printf("Enter valid Emailid: ");
        }

    } while (valid != 1);

    book->contactcount++;

    printf("Contact Saved Successfully\n\n");
}

/* search contact */
int searchContact(struct addressbook *book)
{
    int choice;
    int i;
    char searchdata[25];

    printf("\nSearch contact by:\n");
    printf("1. Name\n");
    printf("2. Phone number\n");
    printf("3. Email\n");
    printf("Enter choice: ");
    scanf("%d", &choice);

    if (choice == 1)
    {
        printf("Enter the name: ");
        scanf(" %[^\n]", searchdata);

        for (i = 0; i < book->contactcount; i++)
        {
            if (strcmp(book->c[i].name, searchdata) == 0)
            {
                return i;
            }
        }
    }
    else if (choice == 2)
    {
        printf("Enter the phone number: ");
        scanf(" %24s", searchdata);

        for (i = 0; i < book->contactcount; i++)
        {
            if (strcmp(book->c[i].phone, searchdata) == 0)
            {
                return i;
            }
        }
    }
    else if (choice == 3)
    {
        printf("Enter the Emailid: ");
        scanf(" %24s", searchdata);

        for (i = 0; i < book->contactcount; i++)
        {
            if (strcmp(book->c[i].email, searchdata) == 0)
            {
                return i;
            }
        }
    }
    else
    {
        printf("Invalid choice\n");
        return -1;
    }

    printf("Contact not found\n");
    return -1;
}

/* search */
void search(struct addressbook *book)
{
    int index;

    index = searchContact(book);

    if (index != -1)
    {
        printf("\nContact found\n");
        printf("Name: %s\n", book->c[index].name);
        printf("Phone number: %s\n", book->c[index].phone);
        printf("Email: %s\n", book->c[index].email);
    }
}

/* edit */
void edit(struct addressbook *book)
{
    int choice;
    int index;
    int i;

    index = searchContact(book);

    if (index == -1)
    {
        return;
    }

    printf("\nWhat you want to edit\n");
    printf("1. name\n");
    printf("2. phone\n");
    printf("3. email\n");
    printf("Enter your choice\n");
    scanf("%d", &choice);

    switch (choice)
    {
        case 1:
        {
            char newname[20];

            printf("Enter the new name: ");
            scanf(" %[^\n]", newname);

            if (namevalidation(newname) == 0)
            {
                printf("Invalid name\n");
                return;
            }

            strcpy(book->c[index].name, newname);

            printf("Name updated successfully\n");
            break;
        }

        case 2:
        {
            char newphone[11];

            printf("Enter the new phone: ");
            scanf(" %10s", newphone);

            if (phonevalidation(newphone) == 0)
            {
                printf("Invalid phone\n");
                return;
            }

            for (i = 0; i < book->contactcount; i++)
            {
                if (i != index &&
                    strcmp(book->c[i].phone, newphone) == 0)
                {
                    printf("Phone number already present\n");
                    return;
                }
            }

            strcpy(book->c[index].phone, newphone);

            printf("Phone updated successfully\n");
            break;
        }

        case 3:
        {
            char newemail[25];

            printf("Enter the new email: ");
            scanf(" %24s", newemail);

            if (emailvalidation(newemail) == 0)
            {
                printf("Invalid email\n");
                return;
            }

            for (i = 0; i < book->contactcount; i++)
            {
                if (i != index &&
                    strcmp(book->c[i].email, newemail) == 0)
                {
                    printf("Email already present\n");
                    return;
                }
            }

            strcpy(book->c[index].email, newemail);

            printf("Email updated successfully\n");
            break;
        }

        default:
            printf("Invalid choice\n");
    }
}

/* delete */
void delete(struct addressbook *book)
{
    int index;
    int i;
    char confirm;

    index = searchContact(book);

    if (index == -1)
    {
        return;
    }

    printf("Are you sure, you wanna delete this contact? [y/n]: ");
    scanf(" %c", &confirm);

    if (confirm == 'y' || confirm == 'Y')
    {
        for (i = index; i < book->contactcount - 1; i++)
        {
            book->c[i] = book->c[i + 1];
        }

        book->contactcount--;

        printf("Contact deleted successfully\n");
    }
    else
    {
        printf("Contact not deleted\n");
    }
}

/* save */
void save(struct addressbook *book)
{
    FILE *fptr;
    int i;

    fptr = fopen("contacts.txt", "w");

    if (fptr == NULL)
    {
        printf("Unable to open file\n");
        return;
    }

    fprintf(fptr, "%d\n", book->contactcount);

    for (i = 0; i < book->contactcount; i++)
    {
        fprintf(fptr, "%s,%s,%s\n",
                book->c[i].name,
                book->c[i].phone,
                book->c[i].email);
    }

    fclose(fptr);

    printf("Contacts saved successfully\n");
}

/* load */
void loadContactsFromFile(struct addressbook *book)
{
    FILE *fptr;
    int i;

    fptr = fopen("contacts.txt", "r");

    if (fptr == NULL)
    {
        book->contactcount = 0;
        return;
    }

    if (fscanf(fptr, "%d\n", &book->contactcount) != 1)
    {
        book->contactcount = 0;
        fclose(fptr);
        return;
    }

    if (book->contactcount > 100)
    {
        book->contactcount = 100;
    }

    for (i = 0; i < book->contactcount; i++)
    {
        fscanf(fptr, "%19[^,],%10[^,],%24[^\n]\n",
               book->c[i].name,
               book->c[i].phone,
               book->c[i].email);
    }

    fclose(fptr);

    printf("Contacts loaded successfully\n");
}

/* list */
void list(struct addressbook *book)
{
    int i;

    if (book->contactcount == 0)
    {
        printf("No contacts available\n");
        return;
    }

    for (i = 0; i < book->contactcount; i++)
    {
        printf("name: %s\n", book->c[i].name);
        printf("phone number: %s\n", book->c[i].phone);
        printf("email: %s\n\n", book->c[i].email);
    }
}

/* main */
int main()
{
    int choice;
    struct addressbook book;

    book.contactcount = 0;

    /* Load existing contacts */
    loadContactsFromFile(&book);

    do
    {
        printf("\nEnter the number as given choice\n");
        printf("1.create\n");
        printf("2.search\n");
        printf("3.edit\n");
        printf("4.delete\n");
        printf("5.list\n");
        printf("6.save\n");
        printf("7.exit\n");

        scanf("%d", &choice);

        if (choice >= 1 && choice <= 7)
        {
            switch (choice)
            {
                case 1:
                    create(&book);
                    break;

                case 2:
                    search(&book);
                    break;

                case 3:
                    edit(&book);
                    break;

                case 4:
                    delete(&book);
                    break;

                case 5:
                    list(&book);
                    break;

                case 6:
                    save(&book);
                    break;

                case 7:
                    save(&book);
                    printf("Exited\n");
                    return 0;
            }
        }
        else
        {
            printf("Enter valid choice: ");
        }

    } while (choice != 7);

    return 0;
}
